{
  "manifest_version": 3,
  "name": "UnEasy-LCSC",
  "description": "Download EasyEDA/LCSC/JLCPCB parts as KiCad symbols, footprints, and STEP models.",
  "version": "0.6.2",

  "browser_specific_settings": {
    "gecko": {
      "id": "uneasy-lcsc@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": ["downloads"],

  "background": {
    "scripts": ["src/background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.lcsc.com/*",
        "*://lcsc.com/*",
        "*://*.jlcpcb.com/*",
        "*://jlcpcb.com/*",
        "*://easyeda.com/editor/*",
        "*://*.easyeda.com/editor/*"
      ],
      "js": ["src/kicad/convert.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "host_permissions": [
    "https://easyeda.com/*",
    "https://*.easyeda.com/*",
    "https://modules.easyeda.com/*",
    "https://lceda.cn/*",
    "https://*.lceda.cn/*",
    "https://modules.lceda.cn/*",
    "https://lcsc.com/*",
    "https://*.lcsc.com/*",
    "https://jlcpcb.com/*",
    "https://*.jlcpcb.com/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": [
        "*://easyeda.com/*",
        "*://*.easyeda.com/*"
      ]
    }
  ]
}
