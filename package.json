{
  "name": "uneasy-lcsc",
  "version": "0.4.2",
  "private": true,
  "description": "Browser extension: EasyEDA symbol/footprint JSON and 3D OBJ export from LCSC/JLCPCB",
  "scripts": {
    "firefox:run": "web-ext run --source-dir . --firefox-profile uneasy-lcsc-dev --keep-profile-changes",
    "firefox:build": "web-ext build --source-dir . --overwrite-dest",
    "firefox:sign": "node scripts/sign-firefox.js",
    "firefox:sign:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/firefox-sign.ps1"
  },
  "devDependencies": {
    "web-ext": "^8.9.0"
  }
}
