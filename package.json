{
  "name": "uneasy-lcsc",
  "version": "0.6.21",
  "private": true,
  "description": "Browser extension: LCSC/JLCPCB parts to KiCad symbols, footprints, and STEP models",
  "scripts": {
    "firefox:run": "web-ext run --source-dir . --firefox-profile uneasy-lcsc-dev --keep-profile-changes",
    "firefox:build": "web-ext build --source-dir . --overwrite-dest",
    "firefox:sign": "node scripts/sign-firefox.js",
    "firefox:sign:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/firefox-sign.ps1",
    "test:footprint-e2e": "node scripts/test-footprint-e2e.js",
    "freeze:footprint": "node scripts/freeze-footprint-fixture.js",
    "test:symbol-e2e": "node scripts/test-symbol-e2e.js",
    "freeze:symbol": "node scripts/freeze-symbol-fixture.js"
  },
  "devDependencies": {
    "web-ext": "^8.9.0"
  },
  "webExt": {
    "ignoreFiles": [
      "artifacts",
      "docs",
      "releases",
      "scripts",
      "tests",
      "web-ext-artifacts",
      "*.md",
      "package.json",
      "package-lock.json"
    ]
  }
}
